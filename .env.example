# Copy to .env.local (read by `npm run dev` and by the npm scripts), then run `npm run secrets` to add the
# generated secrets. Never commit .env.local. On Vercel, set these in Project → Settings → Environment Variables.

# --- Database (PostgreSQL locally, Neon in production) ------------------------------------------------------
DATABASE_URL=postgresql://auditflow:auditflow@localhost:5432/auditflow
# Disposable databases, emptied by `npm test` and `npm run evals` (never point them at DATABASE_URL).
TEST_DATABASE_URL=postgresql://auditflow:auditflow@localhost:5432/auditflow_test
# EVALS_DATABASE_URL=   (defaults to TEST_DATABASE_URL)
# Neon is detected from its host name; force the Neon driver elsewhere with:
# AUDITFLOW_DB_DRIVER=neon

# --- Authentication -------------------------------------------------------------------------------------------
# Clerk (every deployed environment; one Clerk organization per client company).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Local demo accounts (email + password) for development and offline demos only: ignored when Clerk is
# configured and always on Vercel.
AUDITFLOW_DEV_AUTH=1
# AUDITFLOW_SESSION_SECRET=   (generated by `npm run secrets`)
# Password of the demo accounts created by `npm run seed` (default: demo-auditflow).
# AUDITFLOW_DEMO_PASSWORD=

# --- Files ----------------------------------------------------------------------------------------------------
# Vercel Blob (private store) when set; otherwise files go to AUDITFLOW_STORAGE_DIR (default ./var/storage).
# BLOB_READ_WRITE_TOKEN=
# AUDITFLOW_STORAGE_DIR=
AUDITFLOW_MAX_UPLOAD_MB=50
AUDITFLOW_MAX_FILES_PER_UPLOAD=500

# --- AI (document classification only; figures never come from the model) --------------------------------
# none = rules only (default, fully offline); gateway = Vercel AI Gateway.
AUDITFLOW_LLM_PROVIDER=none
# AUDITFLOW_LLM_MODEL=anthropic/claude-opus-5-5
# AI_GATEWAY_API_KEY=   (not needed on Vercel, which authenticates the gateway itself)
# Mask emails, phone numbers and IBANs before anything is sent to the model (default on).
# AUDITFLOW_LLM_REDACT_PII=1

# --- Retention ------------------------------------------------------------------------------------------------
# Vercel Cron calls /api/cron/retention daily with this bearer token (generated by `npm run secrets`).
# CRON_SECRET=
