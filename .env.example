# Copy to .env, then append generated secrets: ./deploy/gen-secrets.sh >> .env
# Never commit .env.

# Required (generated)
# POSTGRES_PASSWORD=
# AUDITFLOW_SECRET_KEY=

# Demo accounts created by `python -m app.seed` (required in production mode to seed)
# AUDITFLOW_DEMO_PASSWORD=

# Optional: Claude for document classification (numbers never come from the LLM)
AUDITFLOW_LLM_PROVIDER=none
# AUDITFLOW_ANTHROPIC_API_KEY=

# Set to true behind HTTPS
AUDITFLOW_COOKIE_SECURE=false

# Only with docker-compose.s3.yml (generated)
# MINIO_ROOT_PASSWORD=
# MINIO_KMS_SECRET_KEY=
