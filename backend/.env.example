# Local development settings, read from backend/.env by app/config.py.
#   cp .env.example .env
# Never commit .env.

AUDITFLOW_ENV=dev
AUDITFLOW_DATABASE_URL=postgresql+psycopg://auditflow:auditflow@localhost:5432/auditflow
# Generate one: openssl rand -hex 32 (if empty, an ephemeral key is used and sessions reset on restart)
AUDITFLOW_SECRET_KEY=

# Jobs run in a background thread of the API; use "rq" with Redis and `python -m app.worker`.
AUDITFLOW_JOB_BACKEND=thread

# Optional: Claude for classifying ambiguous documents (never used for figures)
AUDITFLOW_LLM_PROVIDER=none
# AUDITFLOW_ANTHROPIC_API_KEY=
